SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Server-only secret key (or use SUPABASE_SERVICE_ROLE_KEY for a legacy JWT).
SUPABASE_SECRET_KEY=
# Supabase Connect -> Session pooler URI (port 5432), with database password.
# Only used by scripts/migrate.py; not an API key or the HTTPS project URL.
SUPABASE_DB_URL=
# Preview builds skip migrations unless explicitly enabled for a separate DB.
MIGRATE_PREVIEW=false
INTERNAL_HOST=internal.archetsolutions.com
SITE_URL=https://archetsolutions.com
EMAIL_FROM=mahee123.aamir@gmail.com
EMAIL_TO=mahee123.aamir@gmail.com
EMAIL_APP_PWD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Server-only RT-POS remembered-login cookies, keyed by source account.
# {"connect":{"sec85952EAF_id":"...","sec85952EAF_pd":"..."}, ...}
# Source keys: connect, california, srh, arm1, arm2, arbf. FW_SessionID is ignored.
RTPOS_COOKIES=
# Same random value in Vercel Production and GitHub Actions repository secrets.
CRON_SECRET=
# Vercel automatically uses AI Gateway and the existing SUPABASE_DB_URL.
# An API key is optional when Vercel's automatic OIDC authentication is available.
AI_GATEWAY_API_KEY=
# Free-plan alternative: set WORKFORCE_AI_PROVIDER=groq in Vercel and add this key.
# Create it at https://console.groq.com/keys; keep the account on the Free plan.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
WORKFORCE_MODEL=google/gemini-2.5-flash-lite
# Optional comma-separated model allowlist. Defaults to WORKFORCE_MODEL.
# WORKFORCE_MODELS=google/gemini-2.5-flash-lite
# Providers: groq (Free account option), vercel, or ollama (local only).
# Defaults: vercel on Vercel, ollama locally. To test hosted AI locally:
# WORKFORCE_AI_PROVIDER=vercel
# Ollama and SQLite settings apply only to local development.
WORKFORCE_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
# Optional absolute path; web and worker must share the same persistent file.
# WORKFORCE_DB_PATH=C:/ArchetData/workforce.sqlite3
