SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Server-only secret key (or use SUPABASE_SERVICE_ROLE_KEY for a legacy JWT).
SUPABASE_SECRET_KEY=
# Supabase Connect -> Session pooler URI (port 5432), with database password.
# Only used by scripts/migrate.py; not an API key or the HTTPS project URL.
SUPABASE_DB_URL=
# Preview builds skip migrations unless explicitly enabled for a separate DB.
MIGRATE_PREVIEW=false
INTERNAL_HOST=internal.archetsolutions.com
SITE_URL=https://archetsolutions.com
EMAIL_FROM=mahee123.aamir@gmail.com
EMAIL_TO=mahee123.aamir@gmail.com
EMAIL_APP_PWD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Server-only RT-POS remembered-login cookies, keyed by source account.
# {"connect":{"sec85952EAF_id":"...","sec85952EAF_pd":"..."}, ...}
# Source keys: connect, california, srh, arm1, arm2, arbf. FW_SessionID is ignored.
RTPOS_COOKIES=
# Same random value in Vercel Production and GitHub Actions repository secrets.
CRON_SECRET=
